{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowJs": false,
        "checkJs": false,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [
            "bun-types"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}