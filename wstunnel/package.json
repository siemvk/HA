{
  "name": "@siemsiem/wstunnel",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/ws.js",
  "types": "./dist/ws.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ws.d.ts",
      "default": "./dist/ws.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
